<resources>
    <properties>
        <property id="backendUrl" type="string">https://rower-api-service.onrender.com</property>
        <property id="syncInterval" type="number">2</property>
        <property id="userLoginPrefix" type="string"></property>
        <property id="userLogin" type="string"></property>
    </properties>

    <settings>
        <setting propertyKey="@Properties.backendUrl" title="@Strings.BackendUrlTitle" prompt="@Strings.BackendUrlPrompt">
            <settingConfig type="alphaNumeric" maxLength="128" />
        </setting>
        <setting propertyKey="@Properties.userLoginPrefix" title="@Strings.UserLoginPrefixTitle" prompt="@Strings.UserLoginPrefixPrompt">
            <settingConfig type="alphaNumeric" maxLength="10" />
        </setting>
        <setting propertyKey="@Properties.userLogin" title="@Strings.UserLoginTitle" prompt="@Strings.UserLoginPrompt">
            <settingConfig type="alphaNumeric" maxLength="32" />
        </setting>
    </settings>
</resources>

