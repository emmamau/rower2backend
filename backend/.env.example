PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rower_db
NODE_ENV=development

# --- Intégration Stripe (Abonnements Club & Élite Pro) ---
# Clé secrète Stripe (sk_test_... en mode test ou sk_live_... en production)
STRIPE_SECRET_KEY=
# Clé secrète du webhook Stripe pour écouter les paiements réussis (whsec_...)
STRIPE_WEBHOOK_SECRET=
# (Optionnel) IDs de prix récurrents mensuels créés sur le dashboard Stripe
STRIPE_PRICE_CLUB=
STRIPE_PRICE_PREMIUM=

